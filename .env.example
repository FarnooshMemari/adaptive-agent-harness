# ─── LLM Backend ────────────────────────────────────────────────────────────
# "mock"    → deterministic alert-keyed responses; no AWS credentials required
# "bedrock" → live Amazon Bedrock calls; requires AWS credentials below
LLM_BACKEND=mock

# ─── Amazon Bedrock ──────────────────────────────────────────────────────────
# Only needed when LLM_BACKEND=bedrock
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
AWS_REGION=us-east-1

# AWS credentials (alternatively configure via ~/.aws/credentials or IAM role)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
